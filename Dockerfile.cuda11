# Use NVIDIA CUDA 11.8 base image with Python 3.12
# Note: Using CUDA 11.8 which is compatible with PyTorch CUDA 11.x builds
FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

# Set working directory
WORKDIR /app

# Install Python 3.12 and other dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    python3.12 \
    python3.12-dev \
    git \
    build-essential \
    libssl-dev \
    pkg-config \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set python3.12 as default python
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Copy project files
COPY pyproject.cuda11.toml pyproject.toml
COPY README.md ./

# Verify uv is installed
RUN uv --version

# Install dependencies from pyproject.toml  
# Set GIT_SSL_NO_VERIFY as a workaround for SSL certificate verification issues
# Note: For GPU support, the following changes would be recommended:
# 1. PyTorch: Change pyproject.toml to use CUDA 11.x wheel index
#    [[tool.uv.index]]
#    name = "pytorch-cu118"
#    url = "https://download.pytorch.org/whl/cu118"
# 2. gbgpu: Already GPU-capable, may need CUDA-specific compilation flags
# 3. pycbc: Has GPU support via PyCUDA/cupy - would need cupy-cuda11x installed
# 4. Other packages: Most numpy/scipy based packages will work with GPU via PyTorch/cupy
ENV GIT_SSL_NO_VERIFY=1
RUN uv pip install --system .
ENV GIT_SSL_NO_VERIFY=

# Set the default command to show Python, uv, and CUDA versions
CMD ["sh", "-c", "python --version && uv --version && nvcc --version 2>/dev/null || echo 'CUDA runtime only (no compiler)'"]
